# PostgreSQL connection string used by Prisma and the app server.
# Never expose this to client bundles.
DATABASE_URL="postgresql://vpet:vpet@localhost:5432/virtualpet"

# Optional: separate database used by the feed-pet integration tests.
# The tests are skipped when neither TEST_DATABASE_URL nor DATABASE_URL is set.
# Use a dedicated database here — the tests write and delete rows.
TEST_DATABASE_URL="postgresql://vpet:vpet@localhost:5432/virtualpet_test"

# HMAC secret for deterministic NPC-shop restock generation.
# REQUIRED in production; see docs/operations.md.
RESTOCK_SEED_SECRET="change-me"

# Bearer token for the internal restock cron endpoint (docs/operations.md).
CRON_SECRET="change-me"

# HMAC secret keying the per-band rotations behind the daily word game and
# the lantern hunt. REQUIRED in production. A known value lets anyone
# compute every band's future answers and hiding places; see
# docs/operations.md for rotation guidance.
DAILY_ROTATION_SECRET="change-me"

# Required in production only (startup fails without them there):
# APP_URL="https://example.com"
# TRUSTED_PROXY="false"   # "true" ONLY behind a proxy you control that sets X-Forwarded-For
