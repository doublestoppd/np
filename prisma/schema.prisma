generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  /// Display username, preserved as entered.
  username           String    @unique
  /// Canonical identity: trimmed, lowercased ASCII. Used for uniqueness,
  /// sign-in, profile lookup, and default shop slugs (docs/conventions.md).
  normalizedUsername String    @unique
  passwordHash       String
  /// Wallet balance (authoritative current balance; the ledger is the audit
  /// trail). Non-negative, enforced by a database CHECK constraint.
  coins              BigInt    @default(200)
  isAdmin            Boolean   @default(false)
  /// Set when an administrator disables this account's commerce access.
  commerceDisabledAt DateTime?
  /// Soft deletion/deactivation timestamp; set by the deactivation command.
  deactivatedAt      DateTime?
  createdAt          DateTime  @default(now())

  pets                     Pet[]
  inventory                InventoryEntry[]
  itemInstances            ItemInstance[]
  transactions             Transaction[]
  counterpartyTransactions Transaction[]                @relation("TransactionCounterparty")
  sessions                 Session[]
  profile                  Profile?
  showcaseEntries          ShowcaseEntry[]
  playerShop               PlayerShop?
  sellerListings           PlayerShopListing[]          @relation("SellerListings")
  idempotencyKeys          IdempotencyKey[]
  securityEvents           SecurityEvent[]
  starterClaim             StarterClaim?
  provenanceFrom           ItemProvenanceEvent[]        @relation("ProvenanceFrom")
  provenanceTo             ItemProvenanceEvent[]        @relation("ProvenanceTo")
  dailyWordResults         DailyWordResult[]
  dailyWheelSpins          DailyWheelSpin[]
  dailyFoodClaims          DailyFoodClaim[]
  requestProgress          PlayerRequestBoardProgress[]
  requestCompletions       RequestCompletion[]
  randomEventState         RandomEventState?
  randomEventOccurrences   RandomEventOccurrence[]
  /// When the player was last seen, advanced only when it is genuinely
  /// stale (see modules/arrivals). It exists so the game can say "while
  /// you were away" — before this, nothing anywhere noticed a player had
  /// left, so nothing could ever tell them what had happened since.
  lastSeenAt               DateTime?

  forageFinds       ForageFind[]
  sortingRuns       SortingRun[]
  sortingDailyBests SortingDailyBest[]
  hollow            Hollow?
  giveawayOfferings GiveawayOffering[] @relation("GiveawayDonor")
  giveawayTakes     GiveawayTake[]     @relation("GiveawayTaker")
  lanternSearches   LanternSearch[]
  scratchResults    ScratchResult[]
  fishCatches       FishCatch[]
  fishRecords       FishRecord[]
  matchingRuns      MatchingRun[]
  matchingPayouts   MatchingPayout[]
}

/// Concurrency anchor for starter selection: the unique userId makes a
/// second concurrent claim impossible, without making Pet.ownerId unique
/// (multiple pets may ship later).
model StarterClaim {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  petId     String   @unique
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
}

/// Public-facing profile data, kept separate from the auth-critical User
/// model (see docs/architecture-decisions.md ADR-3). Created lazily on the
/// first profile edit; readers apply defaults when it is missing.
model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio           String   @default("")
  title         String   @default("")
  featuredPetId String?
  featuredPet   Pet?     @relation(fields: [featuredPetId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// A player-chosen, ordered display slot referencing an owned item.
/// References only — item data is never duplicated. Ownership is enforced on
/// write and re-checked on read (docs/profile-and-showcases.md).
model ShowcaseEntry {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Set (only) for instanced definitions: the showcased copy. Stackable
  /// definitions showcase by itemId alone. Enforced by domain policy.
  itemInstanceId String?
  itemInstance   ItemInstance? @relation(fields: [itemInstanceId], references: [id], onDelete: Cascade)
  position       Int
  createdAt      DateTime      @default(now())

  @@unique([userId, itemId])
  /// Positions are dense and unique per player. The domain rewrites the
  /// whole list under a per-user advisory lock, so this constraint is
  /// defense in depth: any future partial-update path that would leave two
  /// entries sharing a slot fails loudly instead of shuffling the display.
  @@unique([userId, position])
}

/// A painted ground a Hollow can hold. Content; see prisma/content/hollow/.
model HollowGroundDefinition {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String
  artKey      String
  /// Authored catalogue order. Not a rank and not a ladder — the price of
  /// your next ground comes from HollowGroundPrice, never from which one
  /// you pick, so choosing a picture is only ever an aesthetic choice.
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  anchors HollowAnchorDefinition[]
  scenes  HollowScene[]
}

/// One authored standing place within a ground.
///
/// Anchors carry a place, a size, and a depth. They carry no rules, no
/// effects, and no behaviour, and they never should: the moment an anchor
/// can change what a furnishing *does*, this is a scripting engine.
model HollowAnchorDefinition {
  id       String                 @id @default(cuid())
  groundId String
  ground   HollowGroundDefinition @relation(fields: [groundId], references: [id], onDelete: Cascade)
  key      String
  /// How a person would refer to the spot: "the near bank".
  label    String
  /// Largest furnishing that fits. Smaller ones fit too.
  maxSize  FurnishingSize
  /// Percentages of the frame, so a Hollow composes identically at every
  /// viewport and there are no pixel coordinates to validate.
  x        Int
  y        Int
  /// Back (0) to front. Also the reading order of the composed
  /// description a screen reader hears.
  depth    Int

  @@unique([groundId, key])
  @@unique([groundId, depth])
}

/// What your *next* ground costs, keyed by how many you already hold.
/// Row 0 is free: a Hollow is somewhere you already live, not an unlock.
model HollowGroundPrice {
  heldCount Int    @id
  price     BigInt
}

/// The light a ground is seen in. Account-wide once held, free to switch.
model HollowAirDefinition {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String
  /// Zero for the air every Hollow opens with.
  price       BigInt
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scenes HollowScene[]
  grants HollowAirGrant[]
}

/// One personal place per account, created the first time it is opened.
///
/// The Hollow is the game's deep coin sink and its only composition
/// surface: painted grounds you buy, airs that repaint them, and
/// furnishings you stand at authored anchors. Nothing here gates anything —
/// a player who never opens it loses access to no shop, region, item, or
/// activity (docs/architecture-decisions.md ADR-39).
model Hollow {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  scenes    HollowScene[]
  airGrants HollowAirGrant[]
}

/// One ground the player owns, in their chosen order, under a chosen air.
///
/// The backdrop and its anchors are content (prisma/content/hollow/); this
/// row stores only which ground, which air, where in the order, and the
/// player's caption. Anchors are authored and fixed — anchor count is
/// deliberately not purchasable, because spending should never be able to
/// make your own picture worse.
model HollowScene {
  id        String                 @id @default(cuid())
  hollowId  String
  hollow    Hollow                 @relation(fields: [hollowId], references: [id], onDelete: Cascade)
  groundId  String
  ground    HollowGroundDefinition @relation(fields: [groundId], references: [id], onDelete: Restrict)
  /// The applied air. Always one this Hollow holds.
  airId     String
  air       HollowAirDefinition    @relation(fields: [airId], references: [id], onDelete: Restrict)
  position  Int
  /// Player-written, plain text, validated like the profile bio.
  caption   String                 @default("")
  createdAt DateTime               @default(now())

  placements HollowPlacement[]

  @@unique([hollowId, groundId])
  @@unique([hollowId, position])
}

/// A furnishing standing at one authored anchor of one ground.
model HollowPlacement {
  id        String      @id @default(cuid())
  sceneId   String
  scene     HollowScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  /// Stable content key of the anchor within that ground.
  anchorKey String
  itemId    String
  item      Item        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  /// When this copy was set down here. Growth is derived from it on read,
  /// exactly as pet needs are derived from timestamps — nothing ticks, and
  /// a player who is away for a month comes back to a taller tree. Moving a
  /// furnishing carries this across; putting it away loses it.
  plantedAt DateTime    @default(now())

  @@unique([sceneId, anchorKey])
  @@index([itemId])
}

/// An air this Hollow holds. Airs are account-wide and free to switch, so
/// every air bought raises the value of every furnishing already owned.
model HollowAirGrant {
  id        String              @id @default(cuid())
  hollowId  String
  hollow    Hollow              @relation(fields: [hollowId], references: [id], onDelete: Cascade)
  airId     String
  air       HollowAirDefinition @relation(fields: [airId], references: [id], onDelete: Restrict)
  grantedAt DateTime            @default(now())

  @@unique([hollowId, airId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PetSpecies {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  /// Key selecting the placeholder SVG artwork variant.
  artKey      String

  pets Pet[]
}

model Pet {
  id             String     @id @default(cuid())
  name           String
  ownerId        String
  owner          User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  speciesId      String
  species        PetSpecies @relation(fields: [speciesId], references: [id])
  /// Stats are 0-100 snapshots taken at statsUpdatedAt. Current values are
  /// derived on the server by applying timestamp-based decay; they are only
  /// persisted again when an interaction (feeding, play, ...) occurs.
  hunger         Int        @default(80)
  happiness      Int        @default(80)
  energy         Int        @default(80)
  health         Int        @default(100)
  statsUpdatedAt DateTime   @default(now())
  /// Stable per-pet seed for this companion's private tastes
  /// (src/server/modules/pets/palate.ts). It never leaves the server: no
  /// view model, action result, log line, or error carries it, because a
  /// palate the game states is a lookup table rather than a discovery.
  palateSeed     String     @default(cuid())
  createdAt      DateTime   @default(now())

  transactions       Transaction[]
  featuredInProfiles Profile[]
  starterClaim       StarterClaim?
  toyUses            PetToyUse[]
  delights           PetDelight[]

  @@index([ownerId])
}

/// A specific thing this companion turned out to love, and when that first
/// happened.
///
/// A record of what has happened, not a set to complete. There is no count
/// column and no total anywhere downstream, and the palate that produces
/// these rows is never enumerated to anybody — so the shelf can show what
/// IS and can never imply what ISN'T.
model PetDelight {
  id      String   @id @default(cuid())
  petId   String
  pet     Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  itemId  String
  item    Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  firstAt DateTime @default(now())

  @@unique([petId, itemId])
  @@index([petId, firstAt])
}

/// When a companion last played with a particular toy.
///
/// Toys are possessions, not consumables, so this row — not an inventory
/// decrement — is what stops one plaything from holding happiness up on
/// its own. The guarded update on `lastUsedAt` is simultaneously the
/// novelty rule and the concurrency winner-picker for simultaneous plays.
model PetToyUse {
  id         String   @id @default(cuid())
  petId      String
  pet        Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime

  @@unique([petId, itemId])
  @@index([petId])
}

/// Typed use-effect discriminator — NOT a display category (ADR-1).
/// Null on Item.type means "no use effect". Only add a value here when a
/// genuinely new game mechanic ships; ordinary item kinds are ItemCategory
/// rows instead.
enum ItemType {
  FOOD
  TOY
  SCRATCH_CARD
}

/// General rarity ladder. Shop pools may assign a shop-specific rarity that
/// differs from the item's general rarity.
enum Rarity {
  COMMON
  UNCOMMON
  RARE
  ULTRA_RARE
}

/// Item lifecycle (docs/conventions.md): DRAFT items are invisible and
/// undistributable; ACTIVE items function normally; RETIRED items are no
/// longer distributed but stay owned/visible/usable/tradeable; DISABLED
/// items are shut off for defect or moderation reasons. Items are never
/// physically deleted once released.
enum ItemLifecycle {
  DRAFT
  ACTIVE
  RETIRED
  DISABLED
}

/// How much acquisition history an item keeps (docs/content-model.md).
/// NONE: audit ledger only. ORIGINAL_SOURCE: first entry into circulation.
/// FULL_HISTORY: notable ownership and transfer history. Items with a
/// policy other than NONE must be instanced (stackable = false).
enum ProvenancePolicy {
  NONE
  ORIGINAL_SOURCE
  FULL_HISTORY
}

/// Data-driven display categorization (Food, Toys, Curios, ...).
/// Adding a category is seed data, not a migration.
model ItemCategory {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String @default("")
  sortOrder   Int    @default(0)

  items Item[]
}

/// Descriptive, non-prescriptive attributes (foraged, river, keepsake, ...).
/// Tags describe content; they never define what a player must collect.
model ItemTag {
  id   String @id @default(cuid())
  slug String @unique
  name String

  items Item[]
}

/// The item definition (catalog entry). Ownership is hybrid: stackable
/// items live in InventoryEntry quantities; non-stackable items get
/// per-copy ItemInstance records.
model Item {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  description      String
  /// Typed gameplay use effect; null = no use effect (see ItemType).
  type             ItemType?
  /// Key selecting artwork (docs/art-direction.md); defaults to the slug.
  artKey           String
  /// Estimated base value in coins; shops price independently.
  /// Non-negative, enforced by a database CHECK constraint.
  price            BigInt
  rarity           Rarity           @default(COMMON)
  /// Whether player shops (and future trading systems) may move this item
  /// between players.
  tradeable        Boolean          @default(true)
  /// Stackable items use quantity inventory; non-stackable use instances.
  stackable        Boolean          @default(true)
  provenancePolicy ProvenancePolicy @default(NONE)
  lifecycle        ItemLifecycle    @default(ACTIVE)
  releasedAt       DateTime?
  retiredAt        DateTime?
  /// Hunger restored when eaten (FOOD only).
  hungerRestore    Int?
  /// Happiness gained when played with (TOY only).
  happinessBoost   Int?
  categoryId       String?
  category         ItemCategory?    @relation(fields: [categoryId], references: [id])
  tags             ItemTag[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  inventoryEntries    InventoryEntry[]
  instances           ItemInstance[]
  poolEntries         NpcShopPoolEntry[]
  npcStock            NpcShopStock[]
  playerListings      PlayerShopListing[]
  transactions        Transaction[]
  petToyUses          PetToyUse[]
  showcaseEntries     ShowcaseEntry[]
  wheelPoolEntries    DailyWheelItemPoolEntry[]
  wheelSpinsAwarded   DailyWheelSpin[]          @relation("WheelAwardedItem")
  foodPoolEntries     DailyFoodPoolEntry[]
  foodClaimsAwarded   DailyFoodClaim[]          @relation("FoodAwardedItem")
  requestRequirements RequestRequirement[]
  forageEntries       ForageSpotEntry[]
  forageFinds         ForageFind[]
  furnishing          Furnishing?
  hollowPlacements    HollowPlacement[]
  petDelights         PetDelight[]
  giveawayOfferings   GiveawayOffering[]
  giveawayTakes       GiveawayTake[]
  scratchCard         ScratchCard?
  scratchPrizes       ScratchPrize[]            @relation("ScratchPrizeItem")
  scratchAwards       ScratchResult[]           @relation("ScratchAwardedItem")
  fishingEntries      FishingSpotEntry[]
  fishCatches         FishCatch[]               @relation("FishCaught")
  fishRecords         FishRecord[]              @relation("FishRecordSpecies")
}

/// How much room a furnishing takes in a painted scene. This is a rendering
/// contract, not a rank: an anchor accepts anything that fits it, and the
/// object is drawn at its own scale. Nothing is "better" for being LARGE,
/// and no view ever orders furnishings by it.
enum FurnishingSize {
  SMALL
  MEDIUM
  LARGE
  /// Permitted only at a scene's single centre anchor.
  CENTREPIECE
}

/// Furnishing-specific data for an Item.
///
/// Kept out of Item on purpose. `ItemType` is the *use-effect*
/// discriminator (docs/content-model.md) and a furnishing has no use
/// effect — it is placed, not used. A side table keyed by itemId also stops
/// Item from growing a nullable column per kind of possession, which is
/// the direction hungerRestore/happinessBoost were already pulling it.
/// A scratch card's prize table (prisma/content/items/scratch-cards.ts is
/// the source of truth).
///
/// Every card carries its whole prize table as rows, and the ACTIVE
/// weights must sum to exactly 10000 basis points — the same discipline
/// the prize wheel uses, for the same reason: the odds shown to the player
/// are computed from these rows, so they cannot drift from the odds the
/// draw actually runs (ADR-46).
model ScratchCard {
  itemId String @id
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// 1-3. Presentation and ordering only — the prize table is the design.
  tier   Int

  prizes ScratchPrize[]
}

enum ScratchPrizeKind {
  COINS
  ITEM
}

/// One outcome on one card. Never edited once a scratch references it:
/// retiring an outcome means `active: false` and a replacement, so history
/// keeps resolving to what actually happened.
model ScratchPrize {
  id           String           @id @default(cuid())
  cardItemId   String
  card         ScratchCard      @relation(fields: [cardItemId], references: [itemId], onDelete: Cascade)
  /// What the player is told they won, in words.
  label        String
  kind         ScratchPrizeKind
  /// Basis points of 10000. Active weights on a card sum to exactly 10000.
  weight       Int
  coinAmount   BigInt?
  prizeItemId  String?
  prizeItem    Item?            @relation("ScratchPrizeItem", fields: [prizeItemId], references: [id], onDelete: Restrict)
  quantity     Int              @default(1)
  displayOrder Int
  active       Boolean          @default(true)

  results ScratchResult[]

  @@unique([cardItemId, displayOrder])
  @@index([cardItemId, active])
}

/// One scratch. Immutable history; the awarded amounts are snapshotted
/// rather than recomputed, so retuning a prize table never rewrites what a
/// player was actually paid.
model ScratchResult {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  prizeId       String
  prize         ScratchPrize @relation(fields: [prizeId], references: [id], onDelete: Restrict)
  awardedCoins  BigInt       @default(0)
  awardedItemId String?
  awardedItem   Item?        @relation("ScratchAwardedItem", fields: [awardedItemId], references: [id], onDelete: Restrict)
  quantity      Int          @default(0)
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([userId, createdAt])
}

model Furnishing {
  itemId     String         @id
  item       Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  size       FurnishingSize
  /// Real days from planting to fully grown. Null for a finished object.
  /// Growth is derived from HollowPlacement.plantedAt on read, never
  /// stored or ticked (the same rule pet needs follow).
  growthDays Int?
}

model InventoryEntry {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id])
  quantity Int    @default(0)

  @@unique([userId, itemId])
  @@index([userId])
}

enum ItemInstanceStatus {
  OWNED
  /// Held by an active player-shop listing; unusable and unlistable
  /// elsewhere until the listing resolves.
  ESCROWED
}

/// A single copy of a non-stackable item. Carries acquisition and (per the
/// definition's provenance policy) transfer history.
model ItemInstance {
  id                String             @id @default(cuid())
  itemId            String
  item              Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  ownerId           String
  owner             User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status            ItemInstanceStatus @default(OWNED)
  acquiredAt        DateTime           @default(now())
  acquisitionSource String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  listings         PlayerShopListing[]
  transactions     Transaction[]
  provenanceEvents ItemProvenanceEvent[]
  showcaseEntries  ShowcaseEntry[]

  @@index([ownerId, status])
  @@index([itemId])
}

/// Canonical append-only provenance history for item instances
/// (docs/architecture-decisions.md). The economic ledger stays the
/// financial audit trail; rows here are the player-facing story and link
/// to the ledger when a financial transaction caused the event.
model ItemProvenanceEvent {
  id             String       @id @default(cuid())
  itemInstanceId String
  itemInstance   ItemInstance @relation(fields: [itemInstanceId], references: [id], onDelete: Restrict)
  /// created | granted | purchased | transferred | admin-correction | retired
  eventType      String
  fromUserId     String?
  fromUser       User?        @relation("ProvenanceFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUserId       String?
  toUser         User?        @relation("ProvenanceTo", fields: [toUserId], references: [id], onDelete: SetNull)
  /// Origin description, e.g. "npc-shop:mossy-market" or "admin-grant".
  sourceType     String
  transactionId  String?
  transaction    Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  /// Player-facing note and any extra context.
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([itemInstanceId, createdAt])
}

/// Top-level world area. Content with published=false is invisible to
/// players (docs/content-model.md).
model Region {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  artKey      String
  sortOrder   Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locations Location[]
}

model Location {
  id          String   @id @default(cuid())
  slug        String
  regionId    String
  region      Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  name        String
  description String
  artKey      String
  sortOrder   Int      @default(0)
  published   Boolean  @default(false)
  /// Optional marker position on the region map, percentages 0-100
  /// (CHECK-constrained). Card/list navigation is the fallback and the
  /// mobile-first presentation.
  mapX        Int?
  mapY        Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  npcShop      NpcShop?
  activities   LocationActivity[]
  forageSpots  ForageSpot[]
  lanternClue  LanternClue?
  fishingSpots FishingSpot[]
  lanternLooks LanternLook[]

  @@unique([regionId, slug])
  @@index([regionId])
}

/// What a player can DO at a location. The set of activity types is
/// explicit and finite (an enum, not free-form strings), and `activityKey`
/// is a stable reference resolved by the owning domain — never a route
/// slug, a script, or generic JSON configuration. Attachments say what is
/// available here; the rules live in the activity's own module.
enum LocationActivityType {
  NPC_SHOP
  DAILY_WORD
  DAILY_WHEEL
  DAILY_MEAL
  REQUEST_BOARD
  FORAGING
  SORTING_BENCH
  GIVEAWAY
  LANTERN_HUNT
  FISHING
  DAILY_DRINK
  MATCHING_GAME
}

model LocationActivity {
  id           String               @id @default(cuid())
  locationId   String
  location     Location             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  type         LocationActivityType
  /// Stable content key of the concrete configuration in the owning
  /// domain (e.g. "mossy-market-shop", "hearth-community-meal").
  activityKey  String
  displayOrder Int                  @default(0)
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([locationId, type, activityKey])
  /// Display order is deterministic: two activities cannot share a slot.
  @@unique([locationId, displayOrder])
  @@index([locationId, active, displayOrder])
  @@index([type, activityKey])
}

/// Somewhere a player can look around and find something.
///
/// Foraging is the game's one acquisition verb the player initiates: the
/// meal deals you an item, the wheel deals you a prize, the shop sells you
/// what it restocked. A spot is content — a weighted pool attached to a
/// location — and it hands out ordinary items, never coins, so it can
/// never be a coin faucet.
model ForageSpot {
  id            String   @id @default(cuid())
  slug          String   @unique
  locationId    String
  location      Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name          String
  /// Fixed flavor copy. Presentation only.
  description   String
  /// Searches allowed per player per UTC game day. Reaching it defers
  /// work to tomorrow; it never takes anything away.
  dailyLimit    Int      @default(3)
  /// Relative weight of finding nothing, alongside the entry weights.
  nothingWeight Int      @default(0)
  /// Newline-joined flavour lines for an empty-handed search.
  nothingFlavor String   @default("")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entries ForageSpotEntry[]
  finds   ForageFind[]

  @@index([locationId, active])
}

/// One possible find, with its selection weight and quantity range.
model ForageSpotEntry {
  id              String     @id @default(cuid())
  spotId          String
  spot            ForageSpot @relation(fields: [spotId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  selectionWeight Int
  minQuantity     Int        @default(1)
  maxQuantity     Int        @default(1)
  active          Boolean    @default(true)

  @@unique([spotId, itemId])
  @@index([spotId, active])
}

/// One search, recorded permanently. Also the daily counter: the cap is a
/// count of these rows for (userId, spotId, gameDate).
model ForageFind {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  spotId        String
  spot          ForageSpot   @relation(fields: [spotId], references: [id], onDelete: Restrict)
  gameDate      String
  /// 1-based position within this player's day at this spot.
  searchOrdinal Int
  /// Null when the search turned up nothing. The row is still written:
  /// an empty-handed look still used one of the day's searches.
  itemId        String?
  item          Item?        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity      Int          @default(0)
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  /// The cap is enforced by this constraint, not only by the count that
  /// precedes it: two concurrent searches racing for the last slot of the
  /// day collide here and exactly one commits.
  @@unique([userId, spotId, gameDate, searchOrdinal])
  @@index([userId, createdAt])
  @@index([spotId, gameDate])
}

/// A place to fish, and what lives in it
/// (prisma/content/fishing/ is the source of truth).
///
/// Deliberately its own table rather than a ForageSpot with a hat on: a
/// forage entry yields a quantity, a fishing entry yields ONE fish with a
/// length drawn from that species' range, and the length is the whole
/// point of the activity.
model FishingSpot {
  id          String   @id @default(cuid())
  slug        String   @unique
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  name        String
  description String
  /// Casts per player per UTC game day.
  dailyLimit  Int      @default(6)
  active      Boolean  @default(true)
  /// Relative weight of a cast that comes back with nothing, drawn from
  /// the same table as the fish rather than layered over it.
  emptyWeight Int      @default(0)
  /// Newline-joined lines, one picked at random for an empty cast.
  emptyFlavor String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries FishingSpotEntry[]
  catches FishCatch[]

  @@index([locationId])
}

/// One species in one spot's table, with the size range it runs to here.
/// The same fish may be bigger in a different water, which is the only
/// reason to prefer one spot over another.
model FishingSpotEntry {
  id              String      @id @default(cuid())
  spotId          String
  spot            FishingSpot @relation(fields: [spotId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  selectionWeight Int
  /// Length range in centimetres, inclusive.
  minLength       Int
  maxLength       Int
  active          Boolean     @default(true)

  @@unique([spotId, itemId])
  @@index([spotId, active])
}

/// One cast. Written even when nothing was caught — an empty cast still
/// used one of the day's casts, so the row is what bounds the day.
model FishCatch {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  spotId        String
  spot          FishingSpot  @relation(fields: [spotId], references: [id], onDelete: Restrict)
  gameDate      String
  /// 1-based position within this player's day at this spot.
  castOrdinal   Int
  /// Null when the cast came back empty.
  itemId        String?
  item          Item?        @relation("FishCaught", fields: [itemId], references: [id], onDelete: Restrict)
  /// Centimetres. Zero for an empty cast.
  lengthCm      Int          @default(0)
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  /// The daily cap is enforced here, not only by the count that precedes
  /// it: two concurrent casts racing for the last slot collide and
  /// exactly one commits.
  @@unique([userId, spotId, gameDate, castOrdinal])
  @@index([userId, createdAt])
  @@index([spotId, gameDate])
}

/// A player's longest catch of a species, ever.
///
/// Private by construction: there is no query anywhere that compares one
/// player's records to another's, and there must not be. The pleasure of
/// a personal best is that it is yours; a leaderboard would turn it into
/// somebody else's number (docs/design-philosophy.md).
model FishRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item     @relation("FishRecordSpecies", fields: [itemId], references: [id], onDelete: Cascade)
  lengthCm  Int
  caughtAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, itemId])
  @@index([userId, lengthCm])
}

enum MatchingDifficulty {
  GENTLE
  BRISK
  DEEP
}

enum MatchingRunStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  /// An illegal flip was submitted. Audited; pays nothing.
  VOID
}

/// One run of the matching game.
///
/// Same security model as the Sorting Bench: the board is NEVER stored.
/// `seed` plus the append-only flip log is the single source of truth and
/// is replayed on every submission, so there is no face for a client to
/// assert and nothing to desynchronise. The seed never leaves the server —
/// a player holding it could read every pair before turning a card.
model MatchingRun {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameDate     String
  difficulty   MatchingDifficulty
  /// Shuffle seed, hex. SERVER ONLY.
  seed         String
  /// Board layout and payout rules frozen at creation, so a later balance
  /// change never rewrites a run already played.
  rulesVersion Int
  status       MatchingRunStatus  @default(IN_PROGRESS)
  /// Append-only flip log: two hex characters per card index.
  flips        String             @default("")
  /// Pairs found so far. Derived from the replay; stored so the daily
  /// best can be read without replaying every run.
  pairsFound   Int                @default(0)
  startedAt    DateTime           @default(now())
  endedAt      DateTime?

  payouts MatchingPayout[]

  @@index([userId, gameDate])
  @@index([userId, startedAt])
}

/// Coins actually paid for a completed run, at most one per run.
///
/// Payout is per difficulty per game day and never repeats: finishing the
/// same board twice pays once, so playing for pleasure costs the economy
/// nothing and a bot earns exactly what a person earns.
model MatchingPayout {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameDate      String
  difficulty    MatchingDifficulty
  runId         String             @unique
  run           MatchingRun        @relation(fields: [runId], references: [id], onDelete: Restrict)
  coins         BigInt
  transactionId String?
  transaction   Transaction?       @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())

  /// One payout per difficulty per day, enforced rather than counted.
  @@unique([userId, gameDate, difficulty])
  @@index([userId, createdAt])
}

enum SortingRunStatus {
  IN_PROGRESS
  /// The deck ran out — everything was sorted.
  COMPLETED
  /// No shelf could take the next find.
  STUCK
  /// Superseded by a new run.
  ABANDONED
  /// An illegal move was submitted. Audited; pays nothing.
  VOID
}

/// One run of the Sorting Bench.
///
/// The board is NEVER stored. `seed` plus `moves` is the single source of
/// truth and is replayed on every submission, which is why there is
/// nothing here for a client to assert and nothing to desynchronise.
model SortingRun {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameDate     String
  /// Shuffle seed, hex. SERVER ONLY — never serialized to any client
  /// payload, log line, or idempotency result.
  seed         String
  /// Deck composition and scoring frozen at creation, so a later balance
  /// change never rewrites a run already played.
  deckVersion  Int
  rulesVersion Int
  status       SortingRunStatus @default(IN_PROGRESS)
  /// Finds consumed. Every batch advances this under an equality guard,
  /// which is what stops a player forking a run they did not like.
  drawIndex    Int              @default(0)
  /// Append-only shelf indices, one character per placement ("31542…").
  moves        String           @default("")
  /// Derived from seed + moves. The client has no vocabulary for a score.
  score        Int              @default(0)
  startedAt    DateTime         @default(now())
  endedAt      DateTime?

  payouts SortingPayout[]

  @@index([userId, gameDate])
  @@index([userId, startedAt])
}

/// Per player per game date. `coinsPaid` is the tier already granted, so
/// a run that raises `bestScore` pays only the difference: replaying pays
/// zero and improving pays exactly once.
model SortingDailyBest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameDate  String
  bestScore Int      @default(0)
  bestRunId String?
  coinsPaid BigInt   @default(0)
  updatedAt DateTime @updatedAt

  payouts SortingPayout[]

  @@unique([userId, gameDate])
  @@index([gameDate])
}

/// One row per coin grant, joined to its ledger row so reconciliation can
/// prove the payouts and the ledger agree.
model SortingPayout {
  id            String           @id @default(cuid())
  dailyBestId   String
  dailyBest     SortingDailyBest @relation(fields: [dailyBestId], references: [id], onDelete: Restrict)
  runId         String
  run           SortingRun       @relation(fields: [runId], references: [id], onDelete: Restrict)
  scoreAtPayout Int
  coins         BigInt
  transactionId String           @unique
  transaction   Transaction      @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  createdAt     DateTime         @default(now())
}

/// An NPC shop is a functional location page. The shopkeeper is static
/// presentation content (artwork + fixed flavor copy), not a character
/// system.
model NpcShop {
  id           String   @id @default(cuid())
  locationId   String   @unique
  location     Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  slug         String   @unique
  name         String
  description  String
  /// Fixed shopkeeper flavor copy. Presentation only — not dialogue.
  keeperCopy   String   @default("")
  keeperArtKey String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  poolEntries   NpcShopPoolEntry[]
  stock         NpcShopStock[]
  restocks      ShopRestock[]
  restockConfig NpcShopRestockConfig?
}

/// The pool an NPC shop restocks from. Weights, prices, quantities, and
/// shop-specific rarity are per-shop; date fields allow explicitly
/// conditioned availability without any season/weather system.
model NpcShopPoolEntry {
  id             String    @id @default(cuid())
  shopId         String
  shop           NpcShop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  shopRarity     Rarity
  /// Fixed price in this shop. Positive, CHECK-constrained.
  price          BigInt
  /// Weighted-selection weight. Positive, CHECK-constrained.
  weight         Int
  /// Inclusive stock bounds per restock. CHECK: 1 <= min <= max.
  minQuantity    Int
  maxQuantity    Int
  active         Boolean   @default(true)
  availableFrom  DateTime?
  availableUntil DateTime?

  @@unique([shopId, itemId])
  @@index([shopId, active])
}

model NpcShopRestockConfig {
  id              String   @id @default(cuid())
  shopId          String   @unique
  shop            NpcShop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// Fixed-interval schedule in minutes, anchored per shop so shops with
  /// the same interval need not restock simultaneously.
  intervalMinutes Int      @default(480)
  /// Per-shop schedule anchor (UTC). Windows are anchor + k * interval.
  anchorAt        DateTime @default(dbgenerated("'1970-01-01 00:00:00'::timestamp without time zone"))
  targetListings  Int      @default(12)
  commonMin       Int      @default(7)
  commonMax       Int      @default(9)
  uncommonMin     Int      @default(2)
  uncommonMax     Int      @default(4)
  rareMin         Int      @default(0)
  rareMax         Int      @default(2)
  /// Ultra-rare eligibility per restock, in basis points (300 = 3%).
  ultraRareBps    Int      @default(300)
  maxUltraRare    Int      @default(1)
  enabled         Boolean  @default(true)
}

enum RestockStatus {
  PENDING
  COMPLETED
  FAILED
}

/// One restock execution for one scheduled window. The unique constraint on
/// (shopId, windowStart) is the idempotency anchor: retries and concurrent
/// attempts converge on a single completed record.
model ShopRestock {
  id           String        @id @default(cuid())
  shopId       String
  shop         NpcShop       @relation(fields: [shopId], references: [id], onDelete: Restrict)
  windowStart  DateTime
  /// Public identifier derived from the seed material. The server secret
  /// itself is never stored.
  seedId       String
  status       RestockStatus @default(PENDING)
  attemptCount Int           @default(0)
  completedAt  DateTime?
  /// Auditable result summary (composition, items, quantities).
  summary      Json?
  error        String?

  stock        NpcShopStock[]
  transactions Transaction[]

  @@unique([shopId, windowStart])
}

enum NpcStockStatus {
  ACTIVE
  SOLD_OUT
  EXPIRED
}

/// A stocked NPC listing. Quantity is globally limited and CHECK-constrained
/// non-negative; sold-out and expired rows are kept for audit history.
model NpcShopStock {
  id              String         @id @default(cuid())
  shopId          String
  shop            NpcShop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  itemId          String
  item            Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  restockId       String
  restock         ShopRestock    @relation(fields: [restockId], references: [id], onDelete: Restrict)
  price           BigInt
  quantity        Int
  initialQuantity Int
  status          NpcStockStatus @default(ACTIVE)
  createdAt       DateTime       @default(now())

  transactions Transaction[]

  @@index([shopId, status])
  @@index([itemId, status])
}

/// One persistent fixed-price storefront per account.
model PlayerShop {
  id                String   @id @default(cuid())
  ownerId           String   @unique
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  slug              String   @unique
  name              String
  description       String   @default("")
  listingCapacity   Int
  /// Sale proceeds waiting in the shop till. Distinct from the wallet;
  /// non-negative, CHECK-constrained.
  unclaimedProceeds BigInt   @default(0)
  lifetimeRevenue   BigInt   @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  listings         PlayerShopListing[]
  upgradePurchases PlayerShopUpgradePurchase[]
}

enum PlayerListingStatus {
  ACTIVE
  SOLD
  CANCELLED
  DISABLED
}

/// A fixed-price listing. The listing row IS the escrow for stackable
/// quantities (removed from InventoryEntry at creation); instanced items are
/// escrowed via ItemInstance.status. Rows are history — never deleted.
model PlayerShopListing {
  id             String              @id @default(cuid())
  shopId         String
  shop           PlayerShop          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  sellerId       String
  seller         User                @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Restrict)
  itemId         String
  item           Item                @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemInstanceId String?
  itemInstance   ItemInstance?       @relation(fields: [itemInstanceId], references: [id], onDelete: Restrict)
  /// Units still on offer. Decrements as buyers take part of the listing
  /// and reaches 0 exactly when the listing flips to SOLD; cancellation
  /// returns whatever is left. Never negative.
  quantity       Int
  /// Units originally listed. Immutable, so `quantityListed - quantity` is
  /// always what has been sold — the invariant reconciliation checks
  /// against the PLAYER_SALE ledger rows.
  quantityListed Int
  /// Fixed unit price. Positive, CHECK-constrained; input bounded by the
  /// shared money module (src/lib/money.ts).
  unitPrice      BigInt
  status         PlayerListingStatus @default(ACTIVE)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  transactions Transaction[]

  @@index([shopId, status])
  @@index([itemId, status, unitPrice])
  @@index([sellerId, status])
}

/// Content-configurable capacity upgrade ladder. Prerequisite = owning the
/// previous tier.
model PlayerShopUpgradeTier {
  id            String  @id @default(cuid())
  tier          Int     @unique
  name          String
  price         BigInt
  capacityBonus Int
  active        Boolean @default(true)

  purchases PlayerShopUpgradePurchase[]
}

model PlayerShopUpgradePurchase {
  id        String                @id @default(cuid())
  shopId    String
  shop      PlayerShop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  tierId    String
  tier      PlayerShopUpgradeTier @relation(fields: [tierId], references: [id], onDelete: Restrict)
  createdAt DateTime              @default(now())

  @@unique([shopId, tierId])
}

/// Stored idempotency results. The unique key makes economic retries return
/// the original outcome instead of repeating the mutation.
model IdempotencyKey {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  operation   String
  key         String
  /// Fingerprint of the material request fields; reuse of a key with a
  /// different fingerprint is rejected.
  requestHash String
  result      Json?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([userId, operation, key])
}

/// Fixed-window rate limiting, database-backed so limits hold across
/// instances.
model RateLimitWindow {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@unique([key, windowStart])
}

/// Structured audit/security log for high-value operations and suspicious
/// activity. Never exposed to ordinary users.
model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String
  severity  String   @default("info")
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([userId, createdAt])
}

enum TransactionType {
  STARTER_GRANT
  ITEM_USE
  NPC_PURCHASE
  PLAYER_LISTING_CREATE
  PLAYER_LISTING_REPRICE
  PLAYER_LISTING_CANCEL
  PLAYER_SALE
  PLAYER_PURCHASE
  PROCEEDS_CLAIM
  CAPACITY_UPGRADE
  ADMIN_ADJUST
  DAILY_WORD_REWARD
  DAILY_WHEEL_PRIZE
  DAILY_FOOD_CLAIM
  REQUEST_REWARD
  FORAGE_FIND
  SORTING_REWARD
  RANDOM_EVENT
  FURNISHING_PURCHASE
  HOLLOW_GROUND
  HOLLOW_AIR
  GIVEAWAY_LEAVE
  GIVEAWAY_TAKE
  LANTERN_FOUND
  SCRATCH_PRIZE
  MATCHING_REWARD
}

/// Per-player pacing anchor for page-view random events.
///
/// This row is the concurrency anchor for the whole roll: the guarded
/// update that claims `lastRollAt` is both the anti-duplicate check and the
/// row lock every later step rides on, so two concurrent rolls can never
/// both proceed from the same eligible moment (docs/architecture-decisions.md
/// ADR-28).
model RandomEventState {
  userId        String    @id
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Last roll ATTEMPT, successful or not. Guards the anti-duplicate window.
  lastRollAt    DateTime
  /// Last roll that actually produced an event. Null until the first one.
  lastEventAt   DateTime?
  /// No event may occur before this instant. Claimed inside the roll.
  cooldownUntil DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// One random event that happened, frozen at the moment it happened.
///
/// Title, message, and effects are stored as resolved text and values, not
/// as a reference to the catalog entry: definitions are code and will be
/// retuned, and a history that silently rewrites itself when a weight
/// changes is not a history. `payload` holds the resolved effect list and
/// the reward summary exactly as the player was shown them.
model RandomEventOccurrence {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// Stable catalog key. Kept for analytics; never re-resolved for display.
  /// UTC game day this happened on. Carried like every other daily
  /// record so the per-day ceiling counts on the same clock the roll
  /// uses, rather than on a database default.
  gameDate      String
  eventKey      String
  title         String
  message       String
  /// Resolved effects and reward summary (ResolvedEventPayload).
  payload       Json
  /// Denormalized for cheap sorting/aggregation; also inside `payload`.
  coinsAwarded  BigInt       @default(0)
  /// Route the player was on, when the client reported one.
  routePath     String?
  /// Ledger row for the economic half, when the event had one.
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  createdAt     DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([userId, gameDate])
  @@index([eventKey])
}

/// Append-only economic ledger. Application code only ever inserts; user
/// deletion is blocked (Restrict) so history cannot be destroyed by
/// cascades.
model Transaction {
  id                 String                  @id @default(cuid())
  userId             String
  user               User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  type               TransactionType
  /// The other party, when one exists (buyer or seller).
  counterpartyUserId String?
  counterparty       User?                   @relation("TransactionCounterparty", fields: [counterpartyUserId], references: [id], onDelete: Restrict)
  itemId             String?
  item               Item?                   @relation(fields: [itemId], references: [id])
  itemInstanceId     String?
  itemInstance       ItemInstance?           @relation(fields: [itemInstanceId], references: [id], onDelete: Restrict)
  petId              String?
  pet                Pet?                    @relation(fields: [petId], references: [id], onDelete: SetNull)
  npcStockId         String?
  npcStock           NpcShopStock?           @relation(fields: [npcStockId], references: [id], onDelete: Restrict)
  playerListingId    String?
  playerListing      PlayerShopListing?      @relation(fields: [playerListingId], references: [id], onDelete: Restrict)
  restockId          String?
  restock            ShopRestock?            @relation(fields: [restockId], references: [id], onDelete: Restrict)
  quantity           Int                     @default(1)
  coinsDelta         BigInt                  @default(0)
  note               String?
  metadata           Json?
  createdAt          DateTime                @default(now())
  provenanceEvents   ItemProvenanceEvent[]
  dailyWordResults   DailyWordResult[]
  lanternSearches    LanternSearch[]
  scratchResults     ScratchResult[]
  fishCatches        FishCatch[]
  matchingPayouts    MatchingPayout[]
  dailyWheelSpins    DailyWheelSpin[]
  dailyFoodClaims    DailyFoodClaim[]
  requestCompletions RequestCompletion[]
  randomEvents       RandomEventOccurrence[]
  forageFinds        ForageFind[]
  sortingPayout      SortingPayout?
  giveawayOfferings  GiveawayOffering[]
  giveawayTakes      GiveawayTake[]

  @@index([userId, createdAt])
  @@index([itemId, createdAt])
  @@index([playerListingId])
  @@index([restockId])
  @@index([type, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 4 — Daily activities (docs/architecture-decisions.md ADR-22).
// Three concrete activities share one global UTC game day, represented as a
// validated "YYYY-MM-DD" string. Each activity keeps its own tables; there
// is deliberately no generic activity/rule/reward engine.
// ---------------------------------------------------------------------------

enum WordDifficulty {
  EASY
  MEDIUM
  HARD
}

enum DailyWordStatus {
  IN_PROGRESS
  SOLVED
  FAILED
}

/// Ordered daily word answers (prisma/content/daily/word-answers.ts is the
/// authored source of truth; words are uppercase A–Z). Each difficulty
/// rotates through its ACTIVE answers in sequencePosition order, one per
/// global game day, wrapping after the last. Submitted guesses are any
/// alphabetic sequence of the correct length — validated by shape only,
/// with no dictionary of accepted guesses.
model DailyWordAnswer {
  id               String         @id @default(cuid())
  difficulty       WordDifficulty
  word             String
  /// Authored rotation order. Append new words after the highest existing
  /// position; never renumber (docs in prisma/content/README.md).
  sequencePosition Int
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  puzzles DailyWordPuzzle[]

  @@unique([difficulty, sequencePosition])
  @@unique([difficulty, word])
  @@index([difficulty, active, sequencePosition])
}

/// One global puzzle per game date and difficulty. The answer reference is
/// frozen at creation: later content edits, deactivations, or reordering
/// never rewrite an existing puzzle.
model DailyWordPuzzle {
  id          String          @id @default(cuid())
  gameDate    String
  difficulty  WordDifficulty
  /// Which rotation band this puzzle serves. A player's band is derived
  /// from their user id (modules/daily/word/rotation.ts), so a leaked
  /// answer is worth one band rather than the whole player base. Bands
  /// are never stored on the player — raising WORD_BANDS redistributes
  /// accounts without a migration, and frozen rows keep their answer.
  band        Int
  answerId    String
  answer      DailyWordAnswer @relation(fields: [answerId], references: [id], onDelete: Restrict)
  rewardCoins BigInt
  createdAt   DateTime        @default(now())

  results DailyWordResult[]

  @@unique([gameDate, difficulty, band])
  @@index([gameDate])
}

/// One result per player per puzzle. attemptsUsed is guarded server-side
/// (equality-guarded update) so concurrent guesses cannot exceed the limit.
model DailyWordResult {
  id                  String          @id @default(cuid())
  userId              String
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzleId            String
  puzzle              DailyWordPuzzle @relation(fields: [puzzleId], references: [id], onDelete: Restrict)
  status              DailyWordStatus @default(IN_PROGRESS)
  attemptsUsed        Int             @default(0)
  rewardCoins         BigInt          @default(0)
  rewardTransactionId String?
  rewardTransaction   Transaction?    @relation(fields: [rewardTransactionId], references: [id], onDelete: SetNull)
  solvedAt            DateTime?
  failedAt            DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  guesses DailyWordGuess[]

  @@unique([userId, puzzleId])
  @@index([userId, createdAt])
  @@index([puzzleId, status])
}

/// Player guesses with stored evaluations (E/P/A per letter). The answer is
/// never stored in player-facing result data.
model DailyWordGuess {
  id          String          @id @default(cuid())
  resultId    String
  result      DailyWordResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  guessNumber Int
  guess       String
  /// One character per letter: E (exact), P (present), A (absent).
  evaluation  String
  createdAt   DateTime        @default(now())

  @@unique([resultId, guessNumber])
}

/// Where the lantern can hide, and the riddle that points there
/// (prisma/content/daily/lantern-clues.ts is the source of truth).
/// A clue row is what makes a location eligible: no clue, no hiding, so
/// an operator can retire a bad riddle without editing the world.
model LanternClue {
  id         String   @id @default(cuid())
  locationId String   @unique
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  /// The riddle shown to players. Names the place without naming it.
  clue       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hunts LanternHunt[]

  @@index([active])
}

/// One day's hiding place for one rotation band. Same banding as the word
/// puzzle (modules/daily/bands.ts): a posted answer is wrong for every
/// other band, and the band is derived from the user id rather than
/// stored.
model LanternHunt {
  id        String      @id @default(cuid())
  gameDate  String
  band      Int
  clueId    String
  clue      LanternClue @relation(fields: [clueId], references: [id], onDelete: Restrict)
  createdAt DateTime    @default(now())

  searches LanternSearch[]

  @@unique([gameDate, band])
  @@index([gameDate])
}

enum LanternSearchStatus {
  SEARCHING
  FOUND
  OUT_OF_LOOKS
}

/// One player's progress against one day's hunt.
model LanternSearch {
  id                  String              @id @default(cuid())
  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  huntId              String
  hunt                LanternHunt         @relation(fields: [huntId], references: [id], onDelete: Restrict)
  status              LanternSearchStatus @default(SEARCHING)
  looksUsed           Int                 @default(0)
  /// Snapshotted when the lantern is found — the reward depends on how
  /// many looks it took, so it cannot be recomputed from config later.
  rewardCoins         BigInt              @default(0)
  rewardTransactionId String?
  rewardTransaction   Transaction?        @relation(fields: [rewardTransactionId], references: [id], onDelete: SetNull)
  foundAt             DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  looks LanternLook[]

  @@unique([userId, huntId])
  @@index([userId, createdAt])
}

/// One look at one location. Kept so the player can see where they have
/// already been — three blind looks with no memory would be a worse game
/// than three looks you can reason from.
model LanternLook {
  id         String        @id @default(cuid())
  searchId   String
  search     LanternSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  lookNumber Int
  locationId String
  location   Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  /// Whether this look found the lantern.
  found      Boolean
  createdAt  DateTime      @default(now())

  @@unique([searchId, lookNumber])
}

enum WheelResultType {
  COINS
  ITEM_POOL
  NOTHING
}

model DailyWheel {
  id     String  @id @default(cuid())
  slug   String  @unique
  name   String
  active Boolean @default(true)

  configurations DailyWheelConfiguration[]
  spins          DailyWheelSpin[]
}

/// Versioned prize configuration. Spins record the exact configuration and
/// prize used, so later changes never rewrite history.
model DailyWheelConfiguration {
  id        String     @id @default(cuid())
  wheelId   String
  wheel     DailyWheel @relation(fields: [wheelId], references: [id], onDelete: Cascade)
  version   Int
  active    Boolean    @default(false)
  createdAt DateTime   @default(now())

  prizes DailyWheelPrize[]
  spins  DailyWheelSpin[]

  @@unique([wheelId, version])
  @@index([wheelId, active])
}

/// A wheel segment. Weights are basis points; active weights must sum to
/// 10000 (validated in the domain layer and by tests, not the database).
model DailyWheelPrize {
  id              String                  @id @default(cuid())
  configurationId String
  configuration   DailyWheelConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  label           String
  /// Display icon (emoji) shown on the wheel segment. Presentation only —
  /// segments render at equal size regardless of weight.
  icon            String                  @default("")
  resultType      WheelResultType
  weight          Int
  coinAmount      BigInt?
  itemPoolId      String?
  itemPool        DailyWheelItemPool?     @relation(fields: [itemPoolId], references: [id], onDelete: Restrict)
  displayOrder    Int
  flavorText      String                  @default("")
  active          Boolean                 @default(true)

  spins DailyWheelSpin[]

  @@index([configurationId, active])
}

model DailyWheelItemPool {
  id     String  @id @default(cuid())
  slug   String  @unique
  active Boolean @default(true)

  entries DailyWheelItemPoolEntry[]
  prizes  DailyWheelPrize[]
}

model DailyWheelItemPoolEntry {
  id              String             @id @default(cuid())
  poolId          String
  pool            DailyWheelItemPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  selectionWeight Int
  minimumQuantity Int                @default(1)
  maximumQuantity Int                @default(1)
  active          Boolean            @default(true)

  @@unique([poolId, itemId])
  @@index([poolId, active])
}

/// One spin per player per wheel per game date (unique constraint). The
/// outcome is committed before any animation data returns to the client.
model DailyWheelSpin {
  id                  String                  @id @default(cuid())
  userId              String
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wheelId             String
  wheel               DailyWheel              @relation(fields: [wheelId], references: [id], onDelete: Restrict)
  gameDate            String
  configurationId     String
  configuration       DailyWheelConfiguration @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  prizeId             String
  prize               DailyWheelPrize         @relation(fields: [prizeId], references: [id], onDelete: Restrict)
  awardedCoins        BigInt                  @default(0)
  awardedItemId       String?
  awardedItem         Item?                   @relation("WheelAwardedItem", fields: [awardedItemId], references: [id], onDelete: Restrict)
  awardedQuantity     Int?
  rewardTransactionId String?
  rewardTransaction   Transaction?            @relation(fields: [rewardTransactionId], references: [id], onDelete: SetNull)
  idempotencyKey      String
  createdAt           DateTime                @default(now())

  @@unique([userId, wheelId, gameDate])
  @@index([userId, createdAt])
  @@index([gameDate])
}

model DailyFoodPool {
  id                   String  @id @default(cuid())
  slug                 String  @unique
  active               Boolean @default(true)
  configurationVersion Int     @default(1)

  entries DailyFoodPoolEntry[]
  claims  DailyFoodClaim[]
}

model DailyFoodPoolEntry {
  id              String        @id @default(cuid())
  poolId          String
  pool            DailyFoodPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  selectionWeight Int
  quantity        Int           @default(1)
  active          Boolean       @default(true)

  @@unique([poolId, itemId])
  @@index([poolId, active])
}

/// One meal claim per player per game date (unique constraint). The awarded
/// item is recorded permanently; retries return it unchanged.
model DailyFoodClaim {
  id                       String        @id @default(cuid())
  userId                   String
  user                     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameDate                 String
  poolId                   String
  pool                     DailyFoodPool @relation(fields: [poolId], references: [id], onDelete: Restrict)
  poolConfigurationVersion Int
  awardedItemId            String
  awardedItem              Item          @relation("FoodAwardedItem", fields: [awardedItemId], references: [id], onDelete: Restrict)
  awardedQuantity          Int
  rewardTransactionId      String?
  rewardTransaction        Transaction?  @relation(fields: [rewardTransactionId], references: [id], onDelete: SetNull)
  idempotencyKey           String
  createdAt                DateTime      @default(now())

  @@unique([userId, gameDate, poolId])
  @@index([userId, createdAt])
  @@index([gameDate])
}

// ---------------------------------------------------------------------
// Request boards (Phase 7). A board is a location activity: an ordered,
// authored list of item-delivery requests each player works through
// independently. No quest log, no dialogue, no expiry, no branching.
// ---------------------------------------------------------------------

/// An ordered list of requests posted at a location. Referenced from a
/// LocationActivity of type REQUEST_BOARD by `key`.
model RequestBoard {
  id                   String   @id @default(cuid())
  key                  String   @unique
  name                 String
  description          String   @default("")
  active               Boolean  @default(true)
  /// Completions allowed per player per UTC game day. A cap protects the
  /// economy; reaching it never removes the next request, it only defers
  /// it to the next game day.
  dailyCompletionLimit Int      @default(3)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  requests    RequestDefinition[]
  progress    PlayerRequestBoardProgress[]
  completions RequestCompletion[]
}

/// One authored request. `sequencePosition` is the authored rotation
/// order; players advance through ACTIVE entries and wrap after the last.
model RequestDefinition {
  id               String       @id @default(cuid())
  boardId          String
  board            RequestBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  slug             String
  title            String
  flavorText       String       @default("")
  sequencePosition Int
  /// Coins granted on completion (BIGINT, like all money).
  rewardCoins      BigInt
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  requirements RequestRequirement[]
  assignedTo   PlayerRequestBoardProgress[]
  completions  RequestCompletion[]

  @@unique([boardId, slug])
  @@unique([boardId, sequencePosition])
  @@index([boardId, active, sequencePosition])
}

/// What a request asks for. Initial version: stackable items only, so
/// there is never ambiguity about which copy is consumed.
model RequestRequirement {
  id                  String            @id @default(cuid())
  requestDefinitionId String
  requestDefinition   RequestDefinition @relation(fields: [requestDefinitionId], references: [id], onDelete: Cascade)
  itemId              String
  item                Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity            Int

  @@unique([requestDefinitionId, itemId])
  @@index([itemId])
}

/// A player's position on one board. `stateVersion` gives the completion
/// command optimistic concurrency: a submission carrying a stale version
/// is refused with the authoritative current view.
model PlayerRequestBoardProgress {
  id                         String             @id @default(cuid())
  userId                     String
  user                       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardId                    String
  board                      RequestBoard       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// The assigned request. Frozen once assigned: later content edits never
  /// rewrite an in-flight assignment.
  currentRequestDefinitionId String?
  currentRequest             RequestDefinition? @relation(fields: [currentRequestDefinitionId], references: [id], onDelete: Restrict)
  totalCompleted             Int                @default(0)
  stateVersion               Int                @default(0)
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@unique([userId, boardId])
}

/// Immutable completion history. Rewards and requirements are snapshotted
/// so history stays auditable after content edits; nothing is ever
/// recomputed from current definitions.
model RequestCompletion {
  id                   String            @id @default(cuid())
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  boardId              String
  board                RequestBoard      @relation(fields: [boardId], references: [id], onDelete: Restrict)
  requestDefinitionId  String
  requestDefinition    RequestDefinition @relation(fields: [requestDefinitionId], references: [id], onDelete: Restrict)
  /// 1-based per player+board; the unique constraint makes a duplicate
  /// completion record impossible.
  completionOrdinal    Int
  /// UTC game day (YYYY-MM-DD) the completion counted against.
  gameDate             String
  rewardCoins          BigInt
  /// What was actually consumed, captured at completion time.
  requirementsSnapshot Json
  transactionId        String?
  transaction          Transaction?      @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  completedAt          DateTime          @default(now())

  @@unique([userId, boardId, completionOrdinal])
  @@index([userId, boardId, gameDate])
  @@index([boardId, completedAt])
}

/// One lot of spare goods left on the communal shelf (modules/giveaway).
///
/// The copies leave the donor's satchel the moment the lot is created, so
/// an offering IS the goods — there is no escrow to return and no second
/// place the same quantity is also recorded. Anything still here when
/// `expiresAt` passes is simply gone: nothing re-grants it, which is what
/// makes the shelf a sink rather than a locker.
///
/// Rows are never deleted. Expiry is evaluated lazily on every read and
/// again inside the taking transaction, so the shelf needs no sweeper, no
/// cron, and no scheduled job to be correct — and the day's caps stay
/// countable after an offering goes cold.
model GiveawayOffering {
  id              String         @id @default(cuid())
  /// Who left it. Kept so a donor cannot take their own goods back out,
  /// and so both halves of the movement have a name in history.
  donorId         String
  donor           User           @relation("GiveawayDonor", fields: [donorId], references: [id], onDelete: Restrict)
  itemId          String
  item            Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  /// How many were left here. Never changes.
  quantity        Int
  /// How many are still unclaimed. Guarded decrements only; reaching zero
  /// is what takes the lot off the shelf early.
  remaining       Int
  /// UTC game day the donation counted against.
  gameDate        String
  /// 1-based position within this donor's day.
  donationOrdinal Int
  offeredAt       DateTime       @default(now())
  /// When this stops being takeable. Set once, at creation, and never
  /// extended — a lot cannot be refreshed to keep a scramble alive.
  expiresAt       DateTime
  transactionId   String?
  transaction     Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  takes           GiveawayTake[]

  /// The donor's daily cap, enforced by the constraint and not only by
  /// the count that precedes it.
  @@unique([donorId, gameDate, donationOrdinal])
  /// The shelf read: unexpired lots with something left, oldest first.
  @@index([expiresAt, remaining])
  @@index([donorId, offeredAt])
}

/// One item taken off the shelf. Immutable history.
model GiveawayTake {
  id            String           @id @default(cuid())
  offeringId    String
  offering      GiveawayOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  takerId       String
  taker         User             @relation("GiveawayTaker", fields: [takerId], references: [id], onDelete: Restrict)
  itemId        String
  item          Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  /// UTC game day the take counted against.
  gameDate      String
  /// 1-based position within this player's day.
  takeOrdinal   Int
  transactionId String?
  transaction   Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  takenAt       DateTime         @default(now())

  /// One per lot per player. A stack left for the shelf is for the shelf,
  /// not for whoever refreshes fastest — and it is also what stops the
  /// shelf being a bulk courier between two accounts.
  @@unique([offeringId, takerId])
  /// The day's cap, as a constraint: two concurrent takes racing for the
  /// last slot collide here and exactly one commits.
  @@unique([takerId, gameDate, takeOrdinal])
  @@index([takerId, takenAt])
}
